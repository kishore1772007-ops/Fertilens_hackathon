ENV=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# MongoDB (Cloud Atlas or Local)
# For MongoDB Cloud Atlas, paste your connection string below:
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=fertilens_db

# Security & JWT
JWT_SECRET_KEY=supersecretjwtkeyforfertilensclinicalappchangeinproduction32char
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Ollama LLM & Embeddings
OLLAMA_CLOUD_HOST=https://ollama.com
OLLAMA_API_KEY=your_ollama_api_key
OLLAMA_LLM_MODEL=gpt-oss:120b
OLLAMA_EMBED_HOST=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768

# RAG & Storage
SIMILARITY_THRESHOLD=0.65
TOP_K_CHUNKS=6
UPLOAD_DIR=storage/uploads
PROCESSED_DIR=storage/processed
MAX_UPLOAD_SIZE_BYTES=10485760

# Data Protection & Field-Level Encryption
ENCRYPTION_KEY=cT9uNQ8vCpKER3w00TT4LsnBEDG1HGoP0GiDVbBOSVc=
SEARCH_INDEX_KEY=c86eafc1b680545e6a3974ed264247ba6081675f3ba0c5959a88d917aa2a1c79
